# Telegram Bot Token (obtido do @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq API Key (obtido em https://console.groq.com)
# Usado para: análise de imagens (Vision API gratuita!)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (obtido em https://aistudio.google.com/app/apikey)
# Usado para: resumos de texto (GRATUITO - 60 req/min, melhor qualidade!)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurações opcionais
DATABASE_PATH=./data/messages.db
LOG_LEVEL=INFO
