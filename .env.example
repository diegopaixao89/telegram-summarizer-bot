# Telegram Bot Token (obtido do @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq API Key (obtido em https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic API Key (OPCIONAL - para análise de imagens com Claude Vision)
# Obtido em https://console.anthropic.com
# Se não configurada, análise de imagens será desabilitada
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Configurações opcionais
DATABASE_PATH=./data/messages.db
LOG_LEVEL=INFO
